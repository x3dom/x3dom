<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" "http://www.web3d.org/specifications/x3d-3.3.dtd">
<X3D profile='Immersive' version='3.3' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='http://www.web3d.org/specifications/x3d-3.0.xsd'>
	<Scene>
            <GeoViewpoint headlight="true" 
                orientation='-1 0 0 1.57'
                centerOfRotation="45.1434 5.72958 300"
                position="45.1434 5.72958 5000"
                zNear="1"
                zFar="1000">
                <!-- <GeoOrigin DEF='GO' geoCoords="45.1434 5.72958 0" rotateYUp="true">
                </GeoOrigin> -->
            </GeoViewpoint>
            <DirectionalLight direction="0, -1, 1" intensity="10"></DirectionalLight>
        <!-- <Transform _rotation='1 0 0 1.5708'>     -->
		    <GeoTileset maximumScreenSpaceError='32' url='"https://bertt.github.io/cesium_3dtiles_samples/samples/1.1/grenoble_trees/tileset.json"'>
                <!-- <GeoOrigin USE='GO' /> -->
                <!-- uses glTF GPU_instancing extension, not currently supported -->
            </GeoTileset>
        <!-- </Transform> -->
    </Scene>
</X3D>

	