<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" "http://www.web3d.org/specifications/x3d-3.3.dtd">
<X3D profile='Immersive' version='3.3' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='http://www.web3d.org/specifications/x3d-3.0.xsd'>
	<Scene>
            <NavigationInfo speed='0.2' />
            <GeoViewpoint speedFactor='0.1' headlight="true" 
                orientation='1 0 0 -1.57'
                centerOfRotation="37.7944 -122.4519 000"
                position="37.7944 -122.4519 80000">
                <GeoOrigin DEF='GO' geoCoords="37.7944 -122.4519 0" rotateYUp="true">
                </GeoOrigin>
                <!-- <GeoOrigin DEF='GO' geoCoords="-6.5976 -78.0015 0" rotateYUp="true"> -->
                <!-- </GeoOrigin> -->
            </GeoViewpoint>
            <DirectionalLight direction="0, -1, 1" intensity="3"></DirectionalLight>
            <!-- my revenc key from Cesium ION:  UUtHZ0RtXzJQNnp5VVBtU1dqQUxVZTA1VTRaOHVhY01CeVNheklBCg==  -->
            <GeoTileset url='"https://tile.googleapis.com/v1/3dtiles/root.json"' >
                <GeoOrigin USE='GO' />
            </GeoTileset>
            <GeoLocation geoCoords="37.7944 -122.4519 0">
                <GeoOrigin USE='GO'/>
                <Transform scale='300 300 300' translation='0 1000 0'>
                    <Transform translation='0 0 -5'>
                        <Inline url='"https://www.web3d.org/x3d/content/examples/Basic/Web3dOutreach/Web3dX3dLogoAnimated.x3d"'></Inline>
                    </Transform>
                </Transform>
            </GeoLocation>  
        <!-- </Transform> -->
    </Scene>
</X3D>

	