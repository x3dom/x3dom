	<Scene>
            <GeoViewpoint headlight="true" 
                orientation='-1 0 0 1.57'
                centerOfRotation="48.764718 11.429633 400"
                position="48.764718 11.429633 4000">
                <GeoOrigin DEF='GO' geoCoords="48.764718 11.429633 0" rotateYUp="true">
                </GeoOrigin>
            </GeoViewpoint>
            <DirectionalLight direction="0, -1, 1" intensity="10"></DirectionalLight>
        <!-- <Transform _rotation='1 0 0 1.5708'>     -->
		    <GeoTileset maximumScreenSpaceError='2' url='"https://bertt.github.io/cesium_3dtiles_samples/samples/1.1/3dcitydb_shaders_ingolstadt/tileset.json"'>
